GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b

SEARCH_API_KEY=

DATABASE_URL=sqlite:///./cartmind.db

FRONTEND_URL=http://localhost:5173

# Base URL of the shopping site Playwright drives. Defaults to the built-in demo store.
STORE_URL=http://127.0.0.1:8000/store

PLAYWRIGHT_HEADLESS=true

# agent = an AI-driven visible browser (Google -> Amazon/Flipkart -> cart). Needs GEMINI_API_KEY_1 (free key).
# live  = scripted Amazon.in search (no AI model needed). demo = offline built-in store.
SHOPPING_MODE=agent
# With PLAYWRIGHT_HEADLESS=false you can solve an Amazon robot check yourself; CartMind never bypasses one.
CAPTCHA_WAIT_SECONDS=120

# --- agent mode ---
# The browser CartMind opens is a normal visible Chrome window. Your logins are kept in BROWSER_PROFILE_DIR.
AGENT_HEADLESS=false
AGENT_BROWSER_CHANNEL=chrome
# Max LLM-driven steps per task
AGENT_RESEARCH_STEPS=12
AGENT_SHOPPING_STEPS=18
# How long the agent waits for you (sign in / robot check) before giving up
USER_ACTION_TIMEOUT=900
AGENT_ALLOWED_DOMAINS=google.com,google.co.in,bing.com,duckduckgo.com,amazon.in,amazon.com,flipkart.com

# On Amazon.in, add to cart with the built-in routine first (no LLM calls); the AI agent is the fallback.
AGENT_FAST_PATH=true
# Where your browser logins are stored (never commit this folder) and the LangGraph checkpoint database.
BROWSER_PROFILE_DIR=./browser_profile
CHECKPOINT_DB=./checkpoints.db

# Speed: start on the Amazon.in results page (shop) or from a web search (google), and how many candidates to collect.
AGENT_START=shop
AGENT_MAX_PRODUCTS=5
